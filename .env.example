# 复制这个文件为 .env，填入真实值
# 不要把 .env 上传到 git！

# MetaMask 钱包私钥（在 MetaMask 设置→安全→导出私钥）
PRIVATE_KEY=0x你的私钥在这里

# Polymarket CLOB API 凭证（在 https://polymarket.com/profile 生成）
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASS=

# 交易参数
BANKROLL=500          # 总资金 USDC
MAX_DAILY_LOSS=50     # 每日最大亏损保护

# DRY_RUN=true 只记录信号，不实际下单
# DRY_RUN=false 真实交易
DRY_RUN=true
